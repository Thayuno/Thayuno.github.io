nav ul li a{
  position: relative;
}

nav ul li:hover a::before {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  height: 1px;
  width: 0;
  background-image: radial-gradient(cyan, #a31aff);
  transform: translate(-50%);
  animation: underline 0.5s ease forwards;
}


@keyframes underline {
  0% {
    width: 0;
  }
  100% {
    width: 110%;
  }
}
