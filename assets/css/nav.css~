nav {
  position: fixed;
  left: 50%;
  top: 5px;
  transform: translate(-50%);
  z-index: 1;
}

nav ul {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #111;
  height: calc(var(--header-height) * 0.8 - 5px);
  padding: 1vh 1vw;
  border-radius: 20px;
}

nav ul li:not(:first-child) {
    margin-left: 1vw;
    position: relative;
    font-family: "Action Man",monospace;
}

nav ul li:not(:first-child)::after {
  content: "";
  width: 1px;
  height: 50%;
  position: absolute;
  top: 50%;
  left: -0.5vw;
  transform: translate(-50%,-50%);
  background-color: white;
}

nav ul li a {
    font-size: 1.5rem;
    align-items: center;
    justify-content: center;
}
